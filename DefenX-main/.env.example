# DefenX Environment Configuration
DEFENX_ENV=development
API_HOST=127.0.0.1
API_PORT=8005
DEFENX_API_PORT=8005
DATABASE_URL=sqlite:///./defenx.db
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
AGENT_API_KEY=dev-agent-key-secret-9942
AGENT_DEVICE_ID=device-primary-win
AGENT_SAMPLE_INTERVAL=5
MODEL_PATH=ml/models/anomaly_model.joblib
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# Ollama (server-side only; never exposed to the browser)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Seconds without telemetry before a device is shown as disconnected
DEFENX_ONLINE_WINDOW_S=30
# Frontend display name (build-time, optional)
VITE_USER_NAME=Operator
